import requests
import pandas as pd

# 中央氣象局 API URL (需要換成你的 API Key)
API_URL = "https://opendata.cwb.gov.tw/api/v1/rest/datastore/O-A0001-001"
API_KEY = "CWB-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"  # 請換成你的 KEY

def fetch_weather_api():
    """嘗試用 API 方式取得資料"""
    try:
        params = {
            "Authorization": API_KEY,
            "format": "JSON"
        }
        response = requests.get(API_URL, params=params, timeout=10)
        response.raise_for_status()
        data = response.json()

        records = data["records"]["location"]
        rows = []
        for r in records:
            station_name = r["locationName"]
            temp = None
            for w in r["weatherElement"]:
                if w["elementName"] == "TEMP":
                    temp = w["elementValue"]
            rows.append({"測站": station_name, "氣溫(°C)": temp})

        return pd.DataFrame(rows)

    except requests.exceptions.RequestException as e:
        print(f"[警告] API 連線失敗: {e}")
        return None

def fetch_weather_html():
    """改用爬 HTML 方式取得資料"""
    print("[提示] 嘗試改用 HTML 爬蟲模式...")
    url = "https://www.cwb.gov.tw/V8/C/W/OBS_Station.html"
    response = requests.get(url, timeout=10)
    tables = pd.read_html(response.text)
    return tables[0]

def main():
    df = fetch_weather_api()
    if df is None:  # 如果 API 失敗，自動改爬 HTML
        df = fetch_weather_html()

    print(df.head(10))  # 顯示前 10 筆

if __name__ == "__main__":
    main()
### 天氣監測系統：MySQL 資料庫架構與實時持久化處理說明

### 一、作品介紹

本模組為「天氣預報雙軌備援系統」的後端資料持久化（Data Persistence）核心。 

* **主要功能**：負責將 Python 透過 API 或 HTML 爬蟲採集到的實時測站氣象數據（如測站名稱、氣溫等），進行資料清洗與型態校驗後，自動化寫入遠端 MySQL 關聯式資料庫中。
* **專案目標**：建置標準化、具備時間戳記的歷史氣象時間序列資料庫（Time-Series Database Foundation），為下游的歷史天氣趨勢分析、大數據報表以及 AI 降雨預測模型提供穩定、乾淨且不重複的結構化黃金數據源。

